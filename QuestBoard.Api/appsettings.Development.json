{
  "ConnectionStrings": {
    "Default": "Data Source=../data/questboard.db"
  },
  "Jwt": {
    "Issuer": "QuestBoard",
    "Audience": "QuestBoard",
    "Key": "use-dotnet-user-secrets-for-this"
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "User": "smtp-user",
    "Pass": "use-dotnet-user-secrets",
    "From": "no-reply@questboard.local"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
